{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "takreem-38.vercel.app"
        }
      ],
      "destination": "/takreem",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hanan-alharbi",
      "destination": "/evidence/index.html"
    }
  ]
}
